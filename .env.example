# Public identifiers only. Never put private keys here: everything VITE_* ends up in the public bundle.
VITE_APP_VERSION=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
# Set to true ONLY if your EmailJS plan supports variable attachments (see README)
VITE_EMAILJS_ATTACH=false
VITE_MAX_IMAGE_MB=1.5
